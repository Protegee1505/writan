{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writan",
  "version": "0.2.0",
  "identifier": "com.writan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Writan",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fast, offline-first Markdown notes",
    "longDescription": "Writan is an offline-first notes app built around plain Markdown files. Notes are ordinary .md files in a folder you choose; the search index is only a cache and can be rebuilt from the files at any time.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/Writan.desktop.metainfo.xml": "bundle/Writan.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/Writan.desktop.metainfo.xml": "bundle/Writan.desktop.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "usr/share/metainfo/Writan.desktop.metainfo.xml": "bundle/Writan.desktop.metainfo.xml"
        }
      }
    }
  }
}
