{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "python *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "cargo *": "allow",
      "rustup *": "allow"
    }
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 1000000
          }
        }
      }
    }
  },
  "plugin": ["billion-context"],
  "compaction": {
    "auto": false
  }
}
