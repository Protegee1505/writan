// Cloud-first development environment (GitHub Codespaces).
// The agent (OpenCode) and its GUI (OpenChamber) run here; local machines
// only need a browser. See docs/CLOUD.md for the daily flow and quotas.
{
  "name": "Writan (cloud)",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // rustup; the repo's rust-toolchain.toml then pins stable and pulls
    // rustfmt + clippy on first cargo use.
    "ghcr.io/devcontainers/features/rust:1": {},
    // Node for the Svelte side — keep in step with the workflows (node 22).
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Codespaces needs an SSH server in the container (for `gh codespace ssh`,
    // VS Code desktop and forwarding); the base image does not ship one.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  // Free tier: 120 core-hours/month ⇒ a 2-core machine runs ≈ 60
  // clock-hours. Pick 4-core only for short heavy stretches (2× burn).
  "hostRequirements": { "cpus": 2 },

  // 3000 = OpenChamber UI, 1420 = Vite dev server. Codespaces forwards both
  // as private, GitHub-authenticated URLs (Ports tab).
  "forwardPorts": [3000, 1420],
  "portsAttributes": {
    "3000": { "label": "OpenChamber", "onAutoForward": "silent" },
    "1420": { "label": "Vite dev server", "onAutoForward": "silent" }
  },

  // post-create: one-time setup (deps, OpenCode + OpenChamber).
  // post-start: runs on every resume and brings the agent UI back up.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
