# Rust
/target
**/target/
Cargo.lock.orig

# Node / frontend
node_modules/
dist/
.svelte-kit/
*.local

# Tauri: schemas are regenerated on every build, the Android project (M5) is
# committed so CI can build the APK without running `android init`.
/app/src-tauri/gen/*
!/app/src-tauri/gen/android

